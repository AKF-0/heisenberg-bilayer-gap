def plusCoefficients {d : ℕ} (a : Fin (d+1) → ℚ) (b : ℚ) (i : Fin (d+1)) : ℚ :=
  (if i = 0 then b else 0) + a i

def minusCoefficients {d : ℕ} (a : Fin (d+1) → ℚ) (b : ℚ) (i : Fin (d+1)) : ℚ :=
  (if i = 0 then b else 0) - a i

theorem eval_plus {d : ℕ} (a : Fin (d+1) → ℚ) (b : ℚ) (g : ℝ) :
    evalCoeff (plusCoefficients a b) g = (b : ℝ) + evalCoeff a g := by
  simp [evalCoeff, plusCoefficients, Rat.cast_add, add_mul,
    Finset.sum_add_distrib, apply_ite, ite_mul]

theorem eval_minus {d : ℕ} (a : Fin (d+1) → ℚ) (b : ℚ) (g : ℝ) :
    evalCoeff (minusCoefficients a b) g = (b : ℝ) - evalCoeff a g := by
  simp [evalCoeff, minusCoefficients, Rat.cast_sub, sub_mul,
    Finset.sum_sub_distrib, apply_ite, ite_mul]

/-- One symbolic kernel-checked basis conversion for degree 10. -/
theorem power_identity10 (w : Fin 11 → ℚ) (g : ℝ) :
    evalCoeff (powerCoefficients10 w) g = bernsteinValue w (10*g) := by
  have hw : w = ![w 0, w 1, w 2, w 3, w 4, w 5, w 6, w 7, w 8, w 9, w 10] := by
    funext i
    fin_cases i <;> rfl
  rw [hw]
  norm_num [evalCoeff, powerCoefficients10, bernsteinValue, Fin.sum_univ_succ,
    Fin.val_succ, Rat.cast_sum, Rat.cast_mul, Rat.cast_pow]
  simp only [← hw]
  ring

#check power_identity10

/-- One symbolic kernel-checked basis conversion for degree 20. -/
theorem power_identity20 (w : Fin 21 → ℚ) (g : ℝ) :
    evalCoeff (powerCoefficients20 w) g = bernsteinValue w (10*g) := by
  have hw : w = ![w 0, w 1, w 2, w 3, w 4, w 5, w 6, w 7, w 8, w 9, w 10, w 11, w 12, w 13, w 14, w 15, w 16, w 17, w 18, w 19, w 20] := by
    funext i
    fin_cases i <;> rfl
  rw [hw]
  norm_num [evalCoeff, powerCoefficients20, bernsteinValue, Fin.sum_univ_succ,
    Fin.val_succ, Rat.cast_sum, Rat.cast_mul, Rat.cast_pow]
  simp only [← hw]
  ring

#check power_identity20

theorem upper_of_coefficients {d : ℕ} (a : Fin (d+1) → ℚ) (b : ℚ)
    (transform : (Fin (d+1) → ℚ) → (Fin (d+1) → ℚ))
    (w : Fin (d+1) → ℚ) (hw : ∀ i, 0 ≤ w i)
    (hc : ∀ i, minusCoefficients a b i = transform w i)
    (hid : ∀ x, evalCoeff (transform w) x = bernsteinValue w (10*x))
    (g : ℝ) (hg : 0 ≤ g) (hmax : g ≤ 1/10) :
    evalCoeff a g ≤ (b : ℝ) := by
  have he : minusCoefficients a b = transform w := funext hc
  have hh := bernsteinValue_nonneg w hw (10*g) (by positivity) (by linarith)
  rw [← hid, ← he, eval_minus] at hh
  linarith

theorem abs_of_coefficients {d : ℕ} (a : Fin (d+1) → ℚ) (b : ℚ)
    (transform : (Fin (d+1) → ℚ) → (Fin (d+1) → ℚ))
    (wp wm : Fin (d+1) → ℚ) (hwp : ∀ i, 0 ≤ wp i) (hwm : ∀ i, 0 ≤ wm i)
    (hcp : ∀ i, plusCoefficients a b i = transform wp i)
    (hcm : ∀ i, minusCoefficients a b i = transform wm i)
    (hidp : ∀ x, evalCoeff (transform wp) x = bernsteinValue wp (10*x))
    (hidm : ∀ x, evalCoeff (transform wm) x = bernsteinValue wm (10*x))
    (g : ℝ) (hg : 0 ≤ g) (hmax : g ≤ 1/10) :
    |evalCoeff a g| ≤ (b : ℝ) := by
  have he : plusCoefficients a b = transform wp := funext hcp
  have hp := bernsteinValue_nonneg wp hwp (10*g) (by positivity) (by linarith)
  rw [← hidp, ← he, eval_plus] at hp
  have hm := upper_of_coefficients a b transform wm hwm hcm hidm g hg hmax
  exact abs_le.mpr ⟨by linarith, hm⟩
/-- A displayed scalar polynomial with its all-real interval envelope. This
record contains no identification with any physical or graph coefficient. -/
structure Envelope where
  coefficients : Fin 11 → ℚ
  upper : ℚ
  bound : ∀ (g : ℝ), 0 ≤ g → g ≤ 1/10 → |evalCoeff coefficients g| ≤ (upper : ℝ)

end BilayerDressed.CubicQuarticCoefficientBernstein
