theorem residual_table64 : ∀ q : Torus.Vertex 4 4,
    coeff 4 4 q=residualTable64 q := by
  have hk1 : k1 4 4=(fun q => kernelTable64 q 0) :=
    funext fun q => (kernel_table64 q).1
  have hk2 : k2 4 4=(fun q => kernelTable64 q 1) :=
    funext fun q => (kernel_table64 q).2.1
  have hk3 : k3 4 4=(fun q => kernelTable64 q 2) :=
    funext fun q => (kernel_table64 q).2.2
  have hb1 : b1 4 4=(fun q => neighborTable64 q 0) :=
    funext fun q => (neighbor_table64 q).1
  have hb2 : b2 4 4=(fun q => neighborTable64 q 1) :=
    funext fun q => (neighbor_table64 q).2.1
  have hb3 : b3 4 4=(fun q => neighborTable64 q 2) :=
    funext fun q => (neighbor_table64 q).2.2
  have hc2 : c2 4 4=(fun q => convolutionTable64 q 0) :=
    funext fun q => (convolution_table64 q).1
  have hc3 : c3 4 4=(fun q => convolutionTable64 q 1) :=
    funext fun q => (convolution_table64 q).2.1
  have hc4 : c4 4 4=(fun q => convolutionTable64 q 2) :=
    funext fun q => (convolution_table64 q).2.2.1
  have hc5 : c5 4 4=(fun q => convolutionTable64 q 3) :=
    funext fun q => (convolution_table64 q).2.2.2.1
  have hc6 : c6 4 4=(fun q => convolutionTable64 q 4) :=
    funext fun q => (convolution_table64 q).2.2.2.2
  simp only [coeff,hk1,hk2,hk3,hb1,hb2,hb3,hc2,hc3,hc4,hc5,hc6]
  intro ⟨x,y⟩
  fin_cases x <;> fin_cases y <;> decide +kernel

#check residual_table64
