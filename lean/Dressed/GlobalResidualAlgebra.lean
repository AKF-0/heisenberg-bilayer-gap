import Dressed.GlobalCreation
import Dressed.LocalDressedResidual

/-!
# Commutative algebra of the actual finite hard-core creation matrices

Only the subalgebra generated by the concrete creation matrices is declared
commutative. The full matrix algebra remains noncommutative.
-/
noncomputable section
open scoped BigOperators
namespace BilayerDressed.GlobalResidual
variable {V : Type*} [Fintype V] [DecidableEq V]

/-- The actual creation-only subalgebra of the finite configuration matrices. -/
def creationAlgebra (V : Type*) [Fintype V] [DecidableEq V] :
    Subalgebra ℝ (ConfigurationMatrix V) :=
  Algebra.adjoin ℝ (Set.range fun p : V × Fin 3 => globalCreate p.1 p.2)

instance : CommRing (creationAlgebra V) :=
  Algebra.adjoinCommRingOfComm ℝ (by
    rintro _ ⟨⟨u,α⟩,rfl⟩ _ ⟨⟨v,β⟩,rfl⟩
    exact (global_creation_commute u v α β).eq)

/-- A generator with its membership proof, not a formal independent variable. -/
def C (v : V) (α : Fin 3) : creationAlgebra V :=
  ⟨globalCreate v α, Algebra.subset_adjoin (Set.mem_range_self (v,α))⟩

@[simp] theorem coe_C (v : V) (α : Fin 3) :
    ((C v α : creationAlgebra V) : ConfigurationMatrix V) = globalCreate v α := rfl

@[simp] theorem C_mul_same (v : V) (α β : Fin 3) : C v α * C v β = 0 := by
  apply Subtype.ext
  exact global_creation_same_site_zero v α β

/-- The standard half-weighted ordered pair generator inside its real commutative algebra. -/
def S (K : V → V → ℝ) : creationAlgebra V :=
  ∑ u, ∑ v, (K u v / 2) • ∑ α : Fin 3, C u α * C v α

theorem coe_S (K : V → V → ℝ) :
    ((S K : creationAlgebra V) : ConfigurationMatrix V) =
      pairKernelOperator (fun u v => K u v / 2) := by
  simp [S, pairKernelOperator, pairCreate]

/-- Nilpotence is inherited from the concrete finite matrices, injectively. -/
theorem S_nilpotent (K : V → V → ℝ) : IsNilpotent (S K) := by
  obtain ⟨m,hm⟩ := pair_kernel_nilpotent (fun u v => K u v / 2)
  refine ⟨m, Subtype.ext ?_⟩
  simpa only [Subalgebra.coe_pow, coe_S, Subalgebra.coe_zero] using hm

end BilayerDressed.GlobalResidual
