theorem convolution_table64 : ∀ q : Torus.Vertex 4 4,
    c2 4 4 q=convolutionTable64 q 0 ∧ c3 4 4 q=convolutionTable64 q 1 ∧
      c4 4 4 q=convolutionTable64 q 2 ∧ c5 4 4 q=convolutionTable64 q 3 ∧
      c6 4 4 q=convolutionTable64 q 4 := by
  have hk1 : k1 4 4=(fun q => kernelTable64 q 0) :=
    funext fun q => (kernel_table64 q).1
  have hk2 : k2 4 4=(fun q => kernelTable64 q 1) :=
    funext fun q => (kernel_table64 q).2.1
  have hk3 : k3 4 4=(fun q => kernelTable64 q 2) :=
    funext fun q => (kernel_table64 q).2.2
  have hb1 : b1 4 4=(fun q => neighborTable64 q 0) :=
    funext fun q => (neighbor_table64 q).1
  have hb2 : b2 4 4=(fun q => neighborTable64 q 1) :=
    funext fun q => (neighbor_table64 q).2.1
  have hb3 : b3 4 4=(fun q => neighborTable64 q 2) :=
    funext fun q => (neighbor_table64 q).2.2
  simp only [c2,c3,c4,c5,c6,conv,hk1,hk2,hk3,hb1,hb2,hb3]
  intro ⟨x,y⟩
  fin_cases x <;> fin_cases y <;> decide +kernel

#check convolution_table64
end BilayerDressed.CubicResidualSeedCoefficients
